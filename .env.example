# Copy to .env, fill in, then: chmod 600 .env
DISCORD_TOKEN=
GUILD_ID=
BLOXLINK_KEY=
# 1 = let the bot hand out Leader (Administrator) by display name match. Not recommended.
AUTO_LEADER=0
# Max Bloxlink lookups per day. Free server keys were announced with 500/day; raise this if you buy API Premium.
BLOXLINK_DAILY_LIMIT=450
# /lfp Join button. PLACE_ID: the number in Glorybound's page URL, roblox.com/games/<PLACE_ID>/...
PLACE_ID=
# Only change if the default Join link doesn't put people in the poster's server (see README, /lfp):
# JOIN_URL=https://<your-github-name>.github.io/<repo>/join.html?placeId={place_id}&userId={user_id}
