# Copy to .env, fill in, then: chmod 600 .env
DISCORD_TOKEN=
GUILD_ID=
BLOXLINK_KEY=
# 1 = let the bot hand out Leader (Administrator) by display name match. Not recommended.
AUTO_LEADER=0
# Max Bloxlink lookups per day. Free server keys were announced with 500/day; raise this if you buy API Premium.
BLOXLINK_DAILY_LIMIT=450
